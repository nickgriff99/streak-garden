PORT=4000
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Supabase requires SSL, local Postgres usually does not. Leave unset (or
# anything other than "false") for Supabase. Set to "false" for a local dev
# database with no SSL listener.
DATABASE_SSL=true
JWT_SECRET=replace-with-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
